{
  "name": "multi-warehouse-inventory-allocation-engine",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install-all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm --prefix backend run start",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test:backend": "npm --prefix backend run test",
    "ai-loop": "node scripts/ai_orchestrator.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
